{
  "name": "wristora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"USER,ADMIN\" -c \"cyan,yellow\" \"npm run dev:user\" \"npm run dev:admin\"",
    "dev:user": "npm --prefix wristora-user run dev",
    "dev:admin": "npm --prefix wristora-admin run dev",
    "build": "npm run build:user && npm run build:admin",
    "build:user": "npm --prefix wristora-user run build",
    "build:admin": "npm --prefix wristora-admin run build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
